<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trajectory_prediction</name>
  <version>0.1.0</version>
  <description>Transformer-based multi-object trajectory prediction</description>
  <maintainer email="es@todo.todo">es</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>prediction_interfaces</depend>

  <!-- torch 已通过 pip 安装，这里仅作声明 -->
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
