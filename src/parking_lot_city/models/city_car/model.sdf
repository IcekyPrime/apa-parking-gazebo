<?xml version="1.0"?>
<sdf version="1.9">
  <!-- 循环行驶的社会车辆（阿克曼、无传感器，避免占用 /scan 话题） -->
  <model name="city_car">
    <pose>0 0 0.02 0 0 0</pose>
    <link name="chassis">
      <pose>0 0 0.62 0 0 0</pose>
      <inertial><mass>1300</mass><inertia><ixx>360</ixx><iyy>1400</iyy><izz>1400</izz></inertia></inertial>
      <collision name="c"><geometry><box><size>4.3 1.82 0.78</size></box></geometry></collision>
      <visual name="body">
        <geometry><box><size>4.3 1.82 0.78</size></box></geometry>
        <material><ambient>0.20 0.34 0.62 1</ambient><diffuse>0.22 0.37 0.68 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="cabin">
        <pose>-0.15 0 0.60 0 0 0</pose>
        <geometry><box><size>2.1 1.65 0.52</size></box></geometry>
        <material><ambient>0.10 0.12 0.15 1</ambient><diffuse>0.12 0.15 0.19 1</diffuse></material>
      </visual>
    </link>

    <link name="fl_steer"><pose>1.35 0.80 0.33 0 0 0</pose><inertial><mass>3</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial></link>
    <joint name="fl_steer_joint" type="revolute">
      <parent>chassis</parent><child>fl_steer</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.61</lower><upper>0.61</upper><effort>600</effort><velocity>3</velocity></limit></axis>
    </joint>
    <!-- 链接本身不旋转（保持关节轴为 Y），只把碰撞/外观的圆柱绕 X 转 90° 使轴向沿 Y，车轮才能滚动 -->
    <!-- [同学 C 修复] 前轮 link 的 <pose> 是相对**模型**坐标系的，必须与转向节同位。
         原文件漏写 <pose>，导致 fl/fr 前轮落到模型原点（车体正中心、贴地），
         视觉上就是「前轮移位到车底、崴脚」。后轮写得正确，所以只有前轮异常。 -->
    <link name="fl_wheel"><pose>1.35 0.80 0.33 0 0 0</pose><inertial><mass>18</mass><inertia><ixx>0.45</ixx><iyy>0.8</iyy><izz>0.45</izz></inertia></inertial>
      <collision name="c"><pose>0 0 0 1.5707 0 0</pose><geometry><cylinder><radius>0.33</radius><length>0.22</length></cylinder></geometry><surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface></collision>
      <visual name="v"><pose>0 0 0 1.5707 0 0</pose><geometry><cylinder><radius>0.33</radius><length>0.22</length></cylinder></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.09 0.09 0.1 1</diffuse></material></visual>
    </link>
    <joint name="fl_wheel_joint" type="revolute"><parent>fl_steer</parent><child>fl_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e9</lower><upper>1e9</upper><effort>600</effort><velocity>60</velocity></limit></axis>
    </joint>

    <link name="fr_steer"><pose>1.35 -0.80 0.33 0 0 0</pose><inertial><mass>3</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial></link>
    <joint name="fr_steer_joint" type="revolute">
      <parent>chassis</parent><child>fr_steer</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.61</lower><upper>0.61</upper><effort>600</effort><velocity>3</velocity></limit></axis>
    </joint>
    <link name="fr_wheel"><pose>1.35 -0.80 0.33 0 0 0</pose><inertial><mass>18</mass><inertia><ixx>0.45</ixx><iyy>0.8</iyy><izz>0.45</izz></inertia></inertial>
      <collision name="c"><pose>0 0 0 1.5707 0 0</pose><geometry><cylinder><radius>0.33</radius><length>0.22</length></cylinder></geometry><surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface></collision>
      <visual name="v"><pose>0 0 0 1.5707 0 0</pose><geometry><cylinder><radius>0.33</radius><length>0.22</length></cylinder></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.09 0.09 0.1 1</diffuse></material></visual>
    </link>
    <joint name="fr_wheel_joint" type="revolute"><parent>fr_steer</parent><child>fr_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e9</lower><upper>1e9</upper><effort>600</effort><velocity>60</velocity></limit></axis>
    </joint>

    <link name="rl_wheel"><pose>-1.35 0.80 0.33 0 0 0</pose><inertial><mass>22</mass><inertia><ixx>0.5</ixx><iyy>0.9</iyy><izz>0.5</izz></inertia></inertial>
      <collision name="c"><pose>0 0 0 1.5707 0 0</pose><geometry><cylinder><radius>0.33</radius><length>0.24</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="v"><pose>0 0 0 1.5707 0 0</pose><geometry><cylinder><radius>0.33</radius><length>0.24</length></cylinder></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.09 0.09 0.1 1</diffuse></material></visual>
    </link>
    <joint name="rl_wheel_joint" type="revolute"><parent>chassis</parent><child>rl_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e9</lower><upper>1e9</upper><effort>900</effort><velocity>60</velocity></limit></axis>
    </joint>

    <link name="rr_wheel"><pose>-1.35 -0.80 0.33 0 0 0</pose><inertial><mass>22</mass><inertia><ixx>0.5</ixx><iyy>0.9</iyy><izz>0.5</izz></inertia></inertial>
      <collision name="c"><pose>0 0 0 1.5707 0 0</pose><geometry><cylinder><radius>0.33</radius><length>0.24</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="v"><pose>0 0 0 1.5707 0 0</pose><geometry><cylinder><radius>0.33</radius><length>0.24</length></cylinder></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.09 0.09 0.1 1</diffuse></material></visual>
    </link>
    <joint name="rr_wheel_joint" type="revolute"><parent>chassis</parent><child>rr_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e9</lower><upper>1e9</upper><effort>900</effort><velocity>60</velocity></limit></axis>
    </joint>

    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>rl_wheel_joint</left_joint>
      <right_joint>rr_wheel_joint</right_joint>
      <left_steering_joint>fl_steer_joint</left_steering_joint>
      <right_steering_joint>fr_steer_joint</right_steering_joint>
      <wheel_base>2.70</wheel_base>
      <wheel_separation>1.60</wheel_separation>
      <wheel_radius>0.33</wheel_radius>
      <steering_limit>0.61</steering_limit>
      <max_velocity>6.0</max_velocity>
      <min_velocity>-2.0</min_velocity>
      <max_acceleration>2.0</max_acceleration>
      <min_acceleration>-3.0</min_acceleration>
      <odom_topic>/traffic/odom</odom_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <topic>/traffic/cmd_vel</topic>
    </plugin>

    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_pose>true</publish_pose>
      <publish_pose_vector>false</publish_pose_vector>
      <publish_frequency>30</publish_frequency>
    </plugin>

    <!-- 无漂移里程计：直接由仿真真值算出相对出生位姿的位姿，供航点驱动使用 -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame></odom_frame>
      <robot_base_frame>chassis</robot_base_frame>
      <odom_topic>/traffic/odom_gt</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
