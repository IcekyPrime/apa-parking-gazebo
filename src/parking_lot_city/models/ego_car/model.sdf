<?xml version="1.0"?>
<sdf version="1.9">
  <!-- 阿克曼转向乘用车：前轮转向、后轮驱动，搭载 2D LiDAR、IMU、单目相机 -->
  <model name="ego_vehicle">
    <pose>0 0 0.02 0 0 0</pose>
    <self_collide>false</self_collide>

    <!-- ================= 车身 ================= -->
    <link name="chassis">
      <pose>0 0 0.62 0 0 0</pose>
      <inertial>
        <!-- 质心压低 0.20 m，抑制后驱加速时的抬头 -->
        <pose>0 0 -0.20 0 0 0</pose>
        <mass>1500</mass>
        <inertia>
          <ixx>420</ixx><iyy>1650</iyy><izz>1650</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>4.35 1.85 0.78</size></box></geometry>
      </collision>
      <!-- [同学 C] 碰撞体保持 4.35×1.85×0.78 不变（规划/避障用它）。
           外观改成「车身抬高 + 窄侧裙」两段，做出轮拱效果：
           原来的外观是一整块 4.35×1.85×0.78 的盒子，而轮子中心 z=0.33、半径
           0.33，有 0.43 m 埋在盒子里；前轮打舵 30° 时露在盒子外的那一小块会
           明显往车体中线摆，看起来就像「前轮移位到车底、崴脚」。
           抬高后车身底沿 z=0.68 刚好压在轮顶 0.66 之上，四个轮子完整可见。 -->
      <!-- [同学 C] 配色：被操控车用高饱和红色 + 自发光，
           与两台干扰车（city_car 蓝 0.22/0.37/0.68、city_car_b 橙 0.68/0.37/0.22）
           明确区分开，并在灰白色路面/建筑背景里一眼能认出来。
           原来的近白色 0.93/0.94/0.96 和路面、墙体几乎同色，远看完全找不到。 -->
      <visual name="body_visual">
        <pose>0 0 0.28 0 0 0</pose>
        <geometry><box><size>4.35 1.74 0.44</size></box></geometry>
        <material>
          <ambient>0.95 0.16 0.10 1</ambient>
          <diffuse>0.90 0.09 0.06 1</diffuse>
          <specular>0.70 0.35 0.30 1</specular>
          <emissive>0.22 0.02 0.01 1</emissive>
        </material>
      </visual>
      <!-- 侧裙：填满前后轮之间车底的空档，宽度收窄到不挡轮子 -->
      <visual name="sill_visual">
        <pose>0 0 -0.12 0 0 0</pose>
        <geometry><box><size>4.10 1.34 0.40</size></box></geometry>
        <material>
          <ambient>0.45 0.06 0.04 1</ambient>
          <diffuse>0.52 0.07 0.05 1</diffuse>
        </material>
      </visual>
      <!-- 座舱（深色玻璃），压低以给车顶 LiDAR 留出水平视野 -->
      <visual name="cabin_visual">
        <pose>-0.15 0 0.48 0 0 0</pose>
        <geometry><box><size>2.15 1.62 0.34</size></box></geometry>
        <material>
          <ambient>0.10 0.12 0.15 1</ambient>
          <diffuse>0.12 0.15 0.19 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <pbr><metal><metalness>0.6</metalness><roughness>0.1</roughness></metal></pbr>
        </material>
      </visual>
      <!-- 前保险杠 -->
      <visual name="front_bumper">
        <pose>2.18 0 -0.2 0 0 0</pose>
        <geometry><box><size>0.12 1.8 0.3</size></box></geometry>
        <material><diffuse>0.18 0.18 0.2 1</diffuse></material>
      </visual>
      <!-- 后保险杠 -->
      <visual name="rear_bumper">
        <pose>-2.18 0 -0.2 0 0 0</pose>
        <geometry><box><size>0.12 1.8 0.3</size></box></geometry>
        <material><diffuse>0.18 0.18 0.2 1</diffuse></material>
      </visual>
      <!-- 车顶 LiDAR 底座 -->
      <visual name="lidar_base">
        <pose>-0.15 0 0.63 0 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.14</length></cylinder></geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>

      <!-- ---------- 传感器 ---------- -->
      <sensor name="lidar2d" type="gpu_lidar">
        <pose>-0.15 0 0.72 0 0 0</pose>
        <topic>/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.20</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>

      <sensor name="imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <topic>/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- 相机暂时停用：ogre2 无头渲染下与 gpu_lidar 同时加载会互相干扰 -->
      <!--
      <sensor name="front_camera" type="camera">
        <pose>2.15 0 0.55 0 0 0</pose>
        <topic>/camera/image</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>80</far></clip>
          <visibility_mask>0x0000FFFF</visibility_mask>
        </camera>
      </sensor>
      -->

    </link>

    <!-- ================= 前轮（转向 + 滚动） ================= -->
    <link name="front_left_steering">
      <pose>1.35 0.80 0.33 0 0 0</pose>
      <inertial><mass>3</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
    </link>
    <joint name="front_left_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.61</lower><upper>0.61</upper><effort>4000</effort><velocity>3.0</velocity></limit>
      </axis>
    </joint>

    <link name="front_left_wheel">
      <!-- 链接位姿是相对模型坐标系，必须与转向节同位（否则前轮落到车体中心地面） -->
      <pose>1.35 0.80 0.33 0 0 0</pose>
      <inertial><mass>18</mass><inertia><ixx>0.45</ixx><iyy>0.8</iyy><izz>0.45</izz></inertia></inertial>
      <collision name="collision">
        <!-- 圆柱默认轴向 Z，旋转 90°(roll) 使其轴向沿 Y；链接本身保持不旋转以保持关节轴 Y -->
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.33</radius><length>0.22</length></cylinder></geometry>
        <surface><friction><ode><mu>1.3</mu><mu2>1.3</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.33</radius><length>0.22</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.1 0.1 0.11 1</diffuse></material>
      </visual>
      <visual name="rim">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.19</radius><length>0.23</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering</parent>
      <child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e9</lower><upper>1e9</upper><effort>800</effort><velocity>60</velocity></limit></axis>
    </joint>

    <link name="front_right_steering">
      <pose>1.35 -0.80 0.33 0 0 0</pose>
      <inertial><mass>3</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
    </link>
    <joint name="front_right_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.61</lower><upper>0.61</upper><effort>4000</effort><velocity>3.0</velocity></limit>
      </axis>
    </joint>

    <link name="front_right_wheel">
      <pose>1.35 -0.80 0.33 0 0 0</pose>
      <inertial><mass>18</mass><inertia><ixx>0.45</ixx><iyy>0.8</iyy><izz>0.45</izz></inertia></inertial>
      <collision name="collision">
        <!-- 圆柱默认轴向 Z，旋转 90°(roll) 使其轴向沿 Y；链接本身保持不旋转以保持关节轴 Y -->
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.33</radius><length>0.22</length></cylinder></geometry>
        <surface><friction><ode><mu>1.3</mu><mu2>1.3</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.33</radius><length>0.22</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.1 0.1 0.11 1</diffuse></material>
      </visual>
      <visual name="rim">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.19</radius><length>0.23</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering</parent>
      <child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e9</lower><upper>1e9</upper><effort>800</effort><velocity>60</velocity></limit></axis>
    </joint>

    <!-- ================= 后轮（驱动） ================= -->
    <link name="rear_left_wheel">
      <pose>-1.35 0.80 0.33 0 0 0</pose>
      <inertial><mass>22</mass><inertia><ixx>0.5</ixx><iyy>0.9</iyy><izz>0.5</izz></inertia></inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.33</radius><length>0.24</length></cylinder></geometry>
        <surface><friction><ode><mu>1.3</mu><mu2>1.3</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.33</radius><length>0.24</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.1 0.1 0.11 1</diffuse></material>
      </visual>
      <visual name="rim">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.19</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e9</lower><upper>1e9</upper><effort>1200</effort><velocity>60</velocity></limit></axis>
    </joint>

    <link name="rear_right_wheel">
      <pose>-1.35 -0.80 0.33 0 0 0</pose>
      <inertial><mass>22</mass><inertia><ixx>0.5</ixx><iyy>0.9</iyy><izz>0.5</izz></inertia></inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.33</radius><length>0.24</length></cylinder></geometry>
        <surface><friction><ode><mu>1.3</mu><mu2>1.3</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.33</radius><length>0.24</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.1 0.1 0.11 1</diffuse></material>
      </visual>
      <visual name="rim">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.19</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e9</lower><upper>1e9</upper><effort>1200</effort><velocity>60</velocity></limit></axis>
    </joint>

    <!-- ================= 阿克曼驱动插件 ================= -->
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <wheel_base>2.70</wheel_base>
      <wheel_separation>1.60</wheel_separation>
      <wheel_radius>0.33</wheel_radius>
      <steering_limit>0.61</steering_limit>
      <max_velocity>4.0</max_velocity>
      <min_velocity>-1.5</min_velocity>
      <max_acceleration>0.8</max_acceleration>
      <min_acceleration>-2.5</min_acceleration>
      <odom_topic>/odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <tf_topic>/tf</tf_topic>
      <topic>/cmd_vel</topic>
    </plugin>

    <!-- 世界坐标系真值位姿：/model/ego_vehicle/pose -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_pose>true</publish_pose>
      <publish_pose_vector>false</publish_pose_vector>
      <publish_frequency>30</publish_frequency>
      <!-- 注意：static_publisher=true 在 gz-sim 8 里会因动态实体 id 查不到而 std::length_error 崩溃，
           只能保持默认（仅位姿变化时发布）；停车时 ROS 侧收不到消息属正常 -->
    </plugin>

    <!-- 无漂移里程计：直接由仿真真值算出相对出生位姿的位姿，供航点驱动使用 -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame></odom_frame>
      <robot_base_frame>chassis</robot_base_frame>
      <odom_topic>/odom_gt</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
