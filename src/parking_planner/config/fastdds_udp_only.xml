<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast-DDS 传输配置：只走 UDPv4，关闭共享内存（SHM）传输。

  背景：在 WSL2 + Fast-DDS 环境下，同一台机器上多次启动/杀死进程后，
  SHM 残留段文件会让新 participant 卡在 rcl_node_init —— 进程活着、CPU 有占用，
  但一个 topic 都不创建，`ros2 node list` 也看不到它。WSL2 对跨进程共享内存
  语义支持不完整，关掉 SHM 改用 UDP 回环后节点发现恢复正常。

  用法（启动任何节点前）：
      export FASTRTPS_DEFAULT_PROFILES_FILE=<本文件绝对路径>
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_transport</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>1048576</sendBufferSize>
      <receiveBufferSize>1048576</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="udp_only_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_transport</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <discovery_config>
          <leaseDuration>
            <sec>5</sec>
          </leaseDuration>
        </discovery_config>
      </builtin>
    </rtps>
  </participant>
</profiles>
